{{page-title "Score History"}}

<PageContent>
  <Card>
    <div class="min-h-svh flex flex-col relative overflow-x-auto">
      <SeasonScoresChart
        @fitAllSeasons={{this.fitAll}}
        @seasonScores={{this.model}}
        @selectedYears={{this.selectedYears}}
      />
      <div class="top-0 right-0 absolute flex flex-col items-end gap-2">
        <SeasonSelect
          @onSelectedYearsChange={{this.onSelectedYearsChange}}
          @seasonScores={{this.model}}
          @selectedYears={{this.selectedYears}}
        />
        <FitAllCheckbox
          @fitAllSeasons={{this.fitAll}}
          @onFitAllSeasonsChange={{this.onFitAllChange}}
        />
      </div>
    </div>
  </Card>
</PageContent>