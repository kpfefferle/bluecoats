{{page-title "Score History"}}

<PageHeader @title="Score History" @subtitle="Relative to DCI Finals" />
<PageContent>
  <div class="grid grid-cols-1 gap-4">
    <Card>
      <div class="grid grid-cols-1 gap-4">
        <SeasonSelect
          @onSelectedYearsChange={{this.onSelectedYearsChange}}
          @seasonScores={{this.model}}
          @selectedYears={{this.selectedYears}}
        />
        <FitAllToggle
          @fitAllSeasons={{this.fitAll}}
          @onFitAllSeasonsChange={{this.onFitAllChange}}
        />
      </div>
    </Card>
    <Card>
      <div class="min-h-svh flex flex-col overflow-x-auto">
        <SeasonScoresChart
          @fitAllSeasons={{this.fitAll}}
          @seasonScores={{this.model}}
          @selectedYears={{this.selectedYears}}
        />
      </div>
    </Card>
  </div>
</PageContent>