<nav class="bg-blue-600">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center">
        <div class="shrink-0">
          <h1 class="text-lg/6 font-semibold text-white">
            <LinkTo @route="index">
              Bluecoats Scores
            </LinkTo>
          </h1>
        </div>
        <div class="hidden md:block">
          <div class="ml-10 flex items-baseline space-x-4">
            {{#each this.navItems as |item|}}
              <LinkTo
                class="rounded-md px-3 py-2 text-sm font-medium text-white hover:bg-blue-500/75"
                @activeClass="bg-blue-700 hover:!bg-blue-700"
                @route={{item.route}}
              >
                {{item.label}}
              </LinkTo>
            {{/each}}
          </div>
        </div>
      </div>
      <div class="-mr-2 flex md:hidden">
        {{! Mobile menu button }}
        <button
          {{on "click" (fn this.setIsMobileMenuOpen (not this.isMobileMenuOpen))}}
          type="button"
          class="relative inline-flex items-center justify-center rounded-md bg-blue-600 p-2 text-blue-200 hover:bg-blue-500/75 hover:text-white focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-600 focus:outline-hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="absolute -inset-0.5"></span>
          <span class="sr-only">Open main menu</span>
          {{#if this.isMobileMenuOpen}}
            <svg
              class="block size-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              aria-hidden="true"
              data-slot="icon"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18 18 6M6 6l12 12"
              />
            </svg>
          {{else}}
            <svg
              class="block size-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              aria-hidden="true"
              data-slot="icon"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
              />
            </svg>
          {{/if}}
        </button>
      </div>
    </div>
  </div>

  {{#if this.isMobileMenuOpen}}
    <div class="md:hidden" id="mobile-menu">
      <div class="space-y-1 px-2 pt-2 pb-3 sm:px-3">
        {{#each this.navItems as |item|}}
          <LinkTo
            class="block rounded-md px-3 py-2 text-base font-medium text-white hover:bg-blue-500/75"
            @activeClass="bg-blue-700 hover:!bg-blue-700"
            @route={{item.route}}
          >
            {{item.label}}
          </LinkTo>
        {{/each}}
      </div>
    </div>
  {{/if}}
</nav>