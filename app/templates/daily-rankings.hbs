{{page-title "Daily Rankings"}}

<Shared::PageHeader
  @title="Daily Rankings"
  @subtitle={{if
    (eq this.selectedDay 0)
    "Finals Day"
    (concat this.selectedDay " days before DCI Finals")
  }}
/>
<Shared::PageContent>
  <div class="grid grid-cols-1 gap-4">
    <Shared::Card>
      <DailyRankings::DaySlider
        @maximum={{this.maxDay}}
        @onChange={{this.onSelectedDayChange}}
        @value={{this.selectedDay}}
      />
    </Shared::Card>
    <Shared::Card>
      {{! TODO: List of scores }}
    </Shared::Card>
  </div>
</Shared::PageContent>