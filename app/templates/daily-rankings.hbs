{{page-title "Daily Rankings"}}

<Shared::PageHeader
  @title="Daily Rankings"
  @subtitle={{if
    (eq this.selectedDay 0)
    "Finals Day"
    (concat this.selectedDay " days before DCI Finals")
  }}
>
  {{#if (not-eq this.selectedDay this.currentDay)}}
    <button
      {{on "click" this.resetToToday}}
      class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
      type="button"
    >
      Reset to Today
    </button>
  {{/if}}
</Shared::PageHeader>
<Shared::PageContent>
  <div class="grid grid-cols-1 gap-4">
    <Shared::Card>
      <DailyRankings::DaySlider
        @maximum={{this.maxDay}}
        @onChange={{this.onSelectedDayChange}}
        @value={{this.selectedDay}}
      />
    </Shared::Card>
    <Shared::Card>
      {{! TODO: List of scores }}
    </Shared::Card>
  </div>
</Shared::PageContent>