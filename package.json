{
  "name": "bluecoats",
  "version": "0.0.0",
  "private": true,
  "description": "DCI Bluecoats historical competition scores",
  "license": "MIT",
  "author": "Kevin Pfefferle",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:knip": "knip",
    "lint:types": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "start": "vite dev",
    "test": "concurrently --kill-others-on-fail --names \"unit,e2e\" --prefixColors auto \"vitest run\" \"playwright test\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "echarts": "^6.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "knip": "^6.29.0",
    "luxon": "^3.7.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">= 20.19.0"
  }
}
